# Copy this file to `.env` at the repository root and fill in your keys.
# `src/constants.py` loads it automatically on import.
# Values already present in the shell environment take precedence over this file.

# Required. Used for embeddings, query rewriting, answer generation and the
# LLM-as-judge evaluator.
OPENAI_API_KEY=sk-...

# Optional. Only needed for cloud reranking (--rerank-jina). The paper's
# results all use the local reranker instead; see requirements_local_reranker.txt.
# JINA_API_KEY=

# Optional. Only needed for the cross-evaluator check (scripts/run_claude_evals.ps1).
# ANTHROPIC_API_KEY=
